#!/usr/bin/env bash
#$ -N trashformer-baseline
#$ -cwd
#$ -j y
#$ -l gpus=1
#$ -l gpu_c=8.0
#$ -pe omp 8
#$ -l h_rt=08:00:00

set -euo pipefail

# Update these for your SCC account before submission.
export PROJECT_ROOT="${PROJECT_ROOT:-/projectnb/yourproject/TrashformerPro}"
export VENV_PATH="${VENV_PATH:-/projectnb/yourproject/venvs/trashformerpro-cu126}"
export PYTHON_MODULE="${PYTHON_MODULE:-python3/3.10.12}"
export VARIANT="${VARIANT:-standardized_256}"
export SEED="${SEED:-42}"
export MODEL="${MODEL:-mobilenet_v3_large}"
export EPOCHS="${EPOCHS:-15}"
export BATCH_SIZE="${BATCH_SIZE:-128}"
export WORKERS="${WORKERS:-8}"
export DEVICE="${DEVICE:-cuda}"

if [[ ! -d "${PROJECT_ROOT}" ]]; then
  echo "PROJECT_ROOT does not exist: ${PROJECT_ROOT}" >&2
  exit 1
fi

if [[ ! -f "${VENV_PATH}/bin/activate" ]]; then
  echo "VENV_PATH is not a ready Python environment: ${VENV_PATH}" >&2
  exit 1
fi

bash "${PROJECT_ROOT}/training/scc/run_baseline.sh"
